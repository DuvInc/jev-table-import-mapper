# The decision model, through OpenRouter. Get a key at https://openrouter.ai
#
# This is the only credential in the repository, and `lib/jev.mjs` is the only
# file that reads it. Copy this file to `.env` and put your key in it:
#
#   cp .env.example .env
#
# `.env` is gitignored. A real environment variable always wins over the file,
# which is what you want in production: keep the key in your secret store and
# never let it reach the browser.
OPENROUTER_API_KEY=your-key-here

# Which model answers. jev 1.13 is what every number in the README was measured
# against.
JEV_MODEL=typesafe/jev-1.13

# Where the typed decisions are posted. Point this at your own gateway or proxy
# if you have one. To change the protocol rather than the address, pass your own
# `decide` function to `mapColumns` and leave this alone.
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions

# How confident a pair has to be before it is mapped without a human. Below it,
# the destination is left empty and the best candidates are offered instead.
# 0.75 is the default and is deliberately cautious: a wrong column is worse
# than an empty one, because nobody reviews a field that looks filled in.
MATCH_THRESHOLD=0.75

# The demo server's port.
PORT=5211
